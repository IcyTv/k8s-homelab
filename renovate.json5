{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":semanticCommitType(chore)"
  ],
  "labels": ["dependencies"],
  "ignorePaths": [
    "apps/base/image-update-automation.yaml",
    "apps/*/image-automation.yaml"
  ],
  "platformAutomerge": false,
  "pinDigests": false,
  "separateMinorPatch": true,
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "flux": {
    "managerFilePatterns": ["/^apps\\/.+\\.yaml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/^apps\\/.+\\.yaml$/"]
  },
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^apps\\/headlamp\\/helmrelease\\.yaml$/"],
      "matchStrings": [
        "source: https://artifacthub\\.io/packages/headlamp/headlamp-plugins/headlamp_flux\\s+version: (?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "headlamp-k8s/plugins",
      "depNameTemplate": "Headlamp Flux plugin",
      "extractVersionTemplate": "^flux-(?<version>.+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^images\\/paperless-sign-service\\/upstream\\.sha$/"],
      "matchStrings": ["(?<currentDigest>[a-f0-9]{40})"],
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/BoBBer446/Paperless-Sign-Service",
      "depNameTemplate": "Paperless signing service upstream"
    }
  ],
  "packageRules": [
    {
      "description": "Track numbered homelab signing image builds",
      "matchPackageNames": ["ghcr.io/icytv/paperless-sign-service"],
      "versioning": "regex:^build-(?<patch>\\d+)$"
    },
    {
      "description": "Automatically merge patch releases after CI passes",
      "matchDatasources": ["docker", "github-releases", "github-tags", "helm"],
      "matchPackageNames": ["!authentik"],
      "matchUpdateTypes": ["patch"],
      "minimumReleaseAge": "3 days",
      "addLabels": ["automerge"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Updates that require review",
      "matchUpdateTypes": ["lockFileMaintenance", "major", "minor"],
      "addLabels": ["review-required"]
    },
    {
      "description": "Kubernetes API migrations require review",
      "matchDatasources": ["kubernetes-api"],
      "addLabels": ["review-required"]
    },
    {
      "description": "Highlight major updates",
      "matchUpdateTypes": ["major"],
      "addLabels": ["major-update"]
    },
    {
      "description": "Authentik upgrades can require ordered migrations",
      "matchPackageNames": ["authentik"],
      "addLabels": ["review-required"],
      "automerge": false
    },
    {
      "description": "Review signing service source updates (git refs have no release timestamps)",
      "matchDepNames": ["Paperless signing service upstream"],
      "minimumReleaseAgeBehaviour": "timestamp-optional",
      "addLabels": ["review-required"],
      "automerge": false
    }
  ]
}
